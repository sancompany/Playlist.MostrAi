<?xml version="1.0" encoding="utf-8"?>
<!--
     Pedido de PIN para sair do Player. Cobre o vídeo, que continua tocando
     por baixo: a exibição em andamento segue valendo como comprovante.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/telaPin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60B0B0F"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pin_titulo"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/displayPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.3"
        android:textColor="#FFFFFF"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/erroPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFB4A9"
        android:textSize="16sp"
        android:visibility="invisible" />

    <GridLayout
        android:id="@+id/tecladoPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="3" />

    <!-- Ações do técnico (atualização por pendrive, teste de ligar a tela). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/botaoVerificarUsb"
            style="@style/BotaoAtualizacao"
            android:text="@string/suporte_verificar_usb"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/botaoInstalarAtualizacao"
            style="@style/BotaoAtualizacao"
            android:layout_marginStart="12dp"
            android:text="@string/suporte_instalar"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/botaoLigarTela"
            style="@style/BotaoAtualizacao"
            android:layout_marginStart="12dp"
            android:text="@string/suporte_ligar_tela"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bloco técnico (Ponto Móvel): só aqui, nunca na tela pública. -->
    <TextView
        android:id="@+id/infoSuporte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#9AA0A6"
        android:textSize="13sp" />
</LinearLayout>
