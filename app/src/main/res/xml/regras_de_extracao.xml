<?xml version="1.0" encoding="utf-8"?>
<!--
    Nada da TV sai por backup na nuvem nem por transferência entre aparelhos
    (Android 12+): a chave do aparelho copiada para outra TV seria a mesma
    tela em dois lugares. `allowBackup="false"` cobre o Android 11 para baixo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
